{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  "extends": [
    "config:base"
  ],

  "timezone": "Europe/Berlin",

  "packageRules": [
    {
      "matchManagers": ["poetry"],
      "enabled": true
    }
  ],

  "regexManagers": [
    {
      "fileMatch": ["^pyproject\\.toml$"],

      "matchStrings": [
        "test-sublibrary\\s*=\\s*\\{[^}]*tag\\s*=\\s*\"(?<currentValue>v\\d+\\.\\d+\\.\\d+)\""
      ],

      "datasourceTemplate": "git-tags",

      "depNameTemplate": "https://github.com/yuliabarabash2601/test_sublibrary.git",

      "versioningTemplate": "semver"
    }
  ]
}
